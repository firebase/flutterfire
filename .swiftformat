--indent 2
--maxwidth 100
--wrapparameters afterfirst
# Apple swift-format from flutter_plugin_tools requires `case .success(let value)` instead of `case let .success(value)`.
# typeSugar rewrites Pigeon's `Optional<Any>.some(Optional<Any>.none)` pattern to
# `Any?.none`, which does not compile ('Any' cannot conform to 'Equatable').
--disable sortedImports,unusedArguments,wrapMultilineStatementBraces,hoistPatternLet,typeSugar
--exclude Pods,**/MainFlutterWindow.swift,**/AppDelegate.swift,**/.symlinks/**
--swiftversion 5.7
